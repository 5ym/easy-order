{
	"name": "easy-order",
	"version": "2.0.0",
	"devDependencies": {
		"@picocss/pico": "2.1.1",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/bun": "1.4.2",
		"@typescript/native": "npm:typescript@7.0.2",
		"sass-embedded": "1.105.0",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"vite": "8.3.1"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"private": true,
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview",
		"start": "bun ./build/index.js",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
		"test": "bun test",
		"db:migrate": "bun run src/lib/server/db.ts",
		"test:e2e": "bun run build && bash scripts/smoke.sh"
	},
	"type": "module"
}
